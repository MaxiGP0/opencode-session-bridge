{
  "name": "opencode-session-bridge",
  "version": "3.0.0",
  "description": "OpenCode plugin to open, interact with, monitor, read, wait for, and safely manage other OpenCode sessions.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "README.es.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "sessions",
    "agents",
    "automation"
  ],
  "author": "Máximo Gomez Pessoa (https://github.com/MaxiGP0)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxiGP0/opencode-session-bridge.git"
  },
  "homepage": "https://github.com/MaxiGP0/opencode-session-bridge#readme",
  "bugs": {
    "url": "https://github.com/MaxiGP0/opencode-session-bridge/issues"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
